Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "CORRECCION", " ", "DE", " ", "INTEGRACION", " ", "DE", " ", "ENERGIA"}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Separamos", " ", "los", " ", "intervalos", " ", "donde", " ", "cambia", " ",
      "la", " ", "corriente"}], ",", " ", 
    RowBox[{"Funcion", " ", "de", " ", "Simpson", " ", 
     RowBox[{"1", "/", "3."}], " ", "Si", " ", "hay", " ", "un", " ", 
     "numero", " ", "impar", " ", "de", " ", "subintervalos"}], ",", 
    RowBox[{
    "usamos", " ", "Simpson", " ", "en", " ", "los", " ", "primeros", " ", 
     "y", " ", "trapecio", " ", "al", " ", 
     RowBox[{"final", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"simpsonCorregido", "[", 
      RowBox[{"valores_", ",", "h_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", "resultado", ",", "primeros"}], "}"}], ",", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{
          RowBox[{"Length", "[", "valores", "]"}], "-", "1"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "<", "1"}], ",", 
          RowBox[{"Return", "[", "0.", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"EvenQ", "[", "n", "]"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{"h", "/", "3"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"First", "[", "valores", "]"}], "+", 
              RowBox[{"Last", "[", "valores", "]"}], "+", 
              RowBox[{"4", " ", 
               RowBox[{"Total", "[", 
                RowBox[{"valores", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ";;", 
                   RowBox[{"-", "2"}], ";;", "2"}], "]"}], "]"}], "]"}]}], "+", 
              RowBox[{"2", " ", 
               RowBox[{"Total", "[", 
                RowBox[{"valores", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ";;", 
                   RowBox[{"-", "2"}], ";;", "2"}], "]"}], "]"}], "]"}]}]}], 
             ")"}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"primeros", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"valores", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"resultado", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"n", ">", "1"}], ",", 
           RowBox[{
            RowBox[{"h", "/", "3"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"First", "[", "primeros", "]"}], "+", 
              RowBox[{"Last", "[", "primeros", "]"}], "+", 
              RowBox[{"4", " ", 
               RowBox[{"Total", "[", 
                RowBox[{"primeros", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ";;", 
                   RowBox[{"-", "2"}], ";;", "2"}], "]"}], "]"}], "]"}]}], "+", 
              RowBox[{"2", " ", 
               RowBox[{"Total", "[", 
                RowBox[{"primeros", "[", 
                 RowBox[{"[", 
                  RowBox[{"3", ";;", 
                   RowBox[{"-", "2"}], ";;", "2"}], "]"}], "]"}], "]"}]}]}], 
             ")"}]}], ",", "0."}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"resultado", "+", 
         RowBox[{"h", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"valores", "[", 
              RowBox[{"[", 
               RowBox[{"-", "2"}], "]"}], "]"}], "+", 
             RowBox[{"valores", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], ")"}], "/", "2"}]}]}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Funcion", " ", "para", " ", "integrar", " ", "respetando", " ", "los", " ",
      "cambios", " ", "de", " ", "corriente"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"integrarEnergia", "[", 
      RowBox[{"resultado_", ",", "h_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"temperaturaMOSFET", ",", 
         RowBox[{"energiaTrap", "=", "0."}], ",", 
         RowBox[{"energiaSimp", "=", "0."}], ",", "inicio", ",", "fin", ",", 
         "corrienteTramo", ",", "tiemposTramo", ",", "potenciasTramo", ",", 
         "j", ",", "energiaLocalTrap", ",", "energiaLocalSimp"}], "}"}], ",", 
       RowBox[{
        RowBox[{"temperaturaMOSFET", "=", 
         RowBox[{"Interpolation", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "}"}], "&"}], 
             ")"}], "/@", "resultado"}], ",", 
           RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"inicio", "=", 
            RowBox[{"90.", "*", "j"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"fin", "=", 
            RowBox[{"90.", "*", 
             RowBox[{"(", 
              RowBox[{"j", "+", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Corriente", " ", "constante", " ", "dentro", " ", "de", " ", 
             "cada", " ", "tramo"}], "*)"}], 
           RowBox[{"corrienteTramo", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"EvenQ", "[", "j", "]"}], ",", "50.", ",", "20."}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"tiemposTramo", "=", 
            RowBox[{"Range", "[", 
             RowBox[{"inicio", ",", "fin", ",", "h"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"potenciasTramo", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"corrienteTramo", "^", "2"}], "*", 
                RowBox[{"rdsOhm", "[", 
                 RowBox[{"temperaturaMOSFET", "[", "#", "]"}], "]"}]}], ")"}],
               "&"}], "/@", "tiemposTramo"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"energiaLocalTrap", "=", 
            RowBox[{"reglaTrapecio", "[", 
             RowBox[{"potenciasTramo", ",", "h"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"energiaLocalSimp", "=", 
            RowBox[{"simpsonCorregido", "[", 
             RowBox[{"potenciasTramo", ",", "h"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"energiaTrap", "+=", "energiaLocalTrap"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"energiaSimp", "+=", "energiaLocalSimp"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "19"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"energiaTrap", ",", "energiaSimp"}], "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Recalcular", " ", "para", " ", "cada", " ", "intervalo"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tablaEnergiaCorregida", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"energiaSinCorregida", "=", 
        RowBox[{"integrarEnergia", "[", 
         RowBox[{"resultadoSinVentilador", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"energiaConCorregida", "=", 
        RowBox[{"integrarEnergia", "[", 
         RowBox[{"resultadoConVentilador", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"tablaEnergiaCorregida", ",", 
         RowBox[{"{", 
          RowBox[{"h", ",", "\"\<Sin ventilador\>\"", ",", 
           RowBox[{"energiaSinCorregida", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"energiaSinCorregida", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "/", "1800."}], ",", 
           RowBox[{"energiaSinCorregida", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"energiaSinCorregida", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "/", "1800."}]}], "}"}]}], "]"}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"tablaEnergiaCorregida", ",", 
         RowBox[{"{", 
          RowBox[{"h", ",", "\"\<Con ventilador\>\"", ",", 
           RowBox[{"energiaConCorregida", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"energiaConCorregida", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "/", "1800."}], ",", 
           RowBox[{"energiaConCorregida", "[", 
