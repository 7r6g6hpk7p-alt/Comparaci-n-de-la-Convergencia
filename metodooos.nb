           RowBox[{
            RowBox[{"energiaConCorregida", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "/", "1800."}]}], "}"}]}], 
        "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"h", ",", 
        RowBox[{"{", 
         RowBox[{"1.", ",", "5.", ",", "10."}], "}"}]}], "}"}]}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
