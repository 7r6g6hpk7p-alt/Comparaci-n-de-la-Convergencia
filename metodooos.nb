   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<ETAPA 4: ENERGIA Y MONTE CARLO\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "1.", " ", "CALCULO", " ", "DE", " ", "POTENCIA", " ", "Y", " ", 
     "ENERGIA"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tiempoTotal", "=", "1800."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pasoBase", "=", "pasoDosNodos"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Calcular", " ", "potencia", " ", "instantanea"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"potenciaSin", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"corrienteDosNodos", "[", 
          RowBox[{"resultadoSinVentilador", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "^", "2"}], "*", 
        RowBox[{"rdsOhm", "[", 
         RowBox[{"resultadoSinVentilador", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "resultadoSinVentilador", "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", "\t", 
   RowBox[{
    RowBox[{"qpotenciaCon", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"corrienteDosNodos", "[", 
          RowBox[{"resultadoConVentilador", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}], "^", "2"}], "*", 
        RowBox[{"rdsOhm", "[", 
         RowBox[{"resultadoConVentilador", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "resultadoConVentilador", "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Crear", " ", "datos", " ", "de", " ", "potencia", " ", "para", " ", 
     "cada", " ", "intervalo"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"crearDatosPotencia", "[", 
      RowBox[{"resultado_", ",", "h_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "salto", ",", "posiciones", ",", "tiemposMuestra", ",", 
         "potenciasMuestra"}], "}"}], ",", 
       RowBox[{
        RowBox[{"salto", "=", 
         RowBox[{"Round", "[", 
          RowBox[{"h", "/", "pasoBase"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"posiciones", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", 
           RowBox[{"Length", "[", "resultado", "]"}], ",", "salto"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"tiemposMuestra", "=", 
         RowBox[{"resultado", "[", 
          RowBox[{"[", 
           RowBox[{"posiciones", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"potenciasMuestra", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"corrienteDosNodos", "[", 
              RowBox[{"tiemposMuestra", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "^", "2"}], "*", 
            RowBox[{"rdsOhm", "[", 
             RowBox[{"resultado", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"posiciones", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", "2", ",", "1"}], "]"}], 
              "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "posiciones", "]"}]}], "}"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"tiemposMuestra", ",", "potenciasMuestra"}], "}"}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Regla", " ", "del", " ", "trapecio"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"reglaTrapecio", "[", 
      RowBox[{"valores_", ",", "h_"}], "]"}], ":=", 
     RowBox[{"h", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"First", "[", "valores", "]"}], "+", 
           RowBox[{"Last", "[", "valores", "]"}]}], ")"}], "/", "2"}], "+", 
        RowBox[{"Total", "[", 
         RowBox[{"Rest", "[", 
          RowBox[{"Most", "[", "valores", "]"}], "]"}], "]"}]}], ")"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Regla", " ", "de", " ", "Simpson", " ", 
     RowBox[{"1", "/", "3"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"reglaSimpson", "[", 
      RowBox[{"valores_", ",", "h_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", "=", 
         RowBox[{
          RowBox[{"Length", "[", "valores", "]"}], "-", "1"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OddQ", "[", "n", "]"}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"h", "/", "3"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"First", "[", "valores", "]"}], "+", 
           RowBox[{"Last", "[", "valores", "]"}], "+", 
           RowBox[{"4", "*", 
            RowBox[{"Total", "[", 
             RowBox[{"valores", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "2"}], ";;", "2"}], "]"}], "]"}], "]"}]}], "+", 
           RowBox[{"2", "*", 
            RowBox[{"Total", "[", 
             RowBox[{"valores", "[", 
              RowBox[{"[", 
               RowBox[{"3", ";;", 
                RowBox[{"-", "2"}], ";;", "2"}], "]"}], "]"}], "]"}]}]}], 
          ")"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Calcular", " ", "energia", " ", "para", " ", "cada", " ", "intervalo"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intervalos", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "5", ",", "10"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"resultadosEnergia", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"datosSin", "=", 
        RowBox[{"crearDatosPotencia", "[", 
         RowBox[{"resultadoSinVentilador", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"datosCon", "=", 
        RowBox[{"crearDatosPotencia", "[", 
         RowBox[{"resultadoConVentilador", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"valoresSin", "=", 
        RowBox[{"datosSin", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"valoresCon", "=", 
        RowBox[{"datosCon", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Energia", " ", "sin", " ", "ventilador"}], "*)"}], 
       RowBox[{"energiaTrapSin", "=", 
        RowBox[{"reglaTrapecio", "[", 
         RowBox[{"valoresSin", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"energiaSimpSin", "=", 
        RowBox[{"reglaSimpson", "[", 
         RowBox[{"valoresSin", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Energia", " ", "con", " ", "ventilador"}], "*)"}], 
       RowBox[{"energiaTrapCon", "=", 
        RowBox[{"reglaTrapecio", "[", 
         RowBox[{"valoresCon", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"energiaSimpCon", "=", 
        RowBox[{"reglaSimpson", "[", 
         RowBox[{"valoresCon", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"resultadosEnergia", ",", 
         RowBox[{"{", 
          RowBox[{"h", ",", "\"\<Sin ventilador\>\"", ",", "energiaTrapSin", ",", 
           RowBox[{"energiaTrapSin", "/", "tiempoTotal"}], ",", 
           "energiaSimpSin", ",", 
           RowBox[{"energiaSimpSin", "/", "tiempoTotal"}]}], "}"}]}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"resultadosEnergia", ",", 
         RowBox[{"{", 
          RowBox[{"h", ",", "\"\<Con ventilador\>\"", ",", "energiaTrapCon", ",", 
           RowBox[{"energiaTrapCon", "/", "tiempoTotal"}], ",", 
           "energiaSimpCon", ",", 
           RowBox[{"energiaSimpCon", "/", "tiempoTotal"}]}], "}"}]}], "]"}]}],
       ",", 
      RowBox[{"{", 
       RowBox[{"h", ",", "intervalos"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\< \>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<TABLA DE ENERGIA Y POTENCIA MEDIA\>\"", "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"TableForm", "[", 
      RowBox[{"resultadosEnergia", ",", 
       RowBox[{"TableHeadings", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Paso (s)\>\"", ",", "\"\<Condicion\>\"", 
            ",", "\"\<Energia Trapecio (J)\>\"", 
            ",", "\"\<Potencia media Trapecio (W)\>\"", 
            ",", "\"\<Energia Simpson (J)\>\"", 
            ",", "\"\<Potencia media Simpson (W)\>\""}], "}"}]}], "}"}]}]}], 
      "]"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "ENERGIA", " ", "DE", " ", "REFERENCIA"}], "*)"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"energiaReferenciaSin", "=", 
     RowBox[{"reglaTrapecio", "[", 
      RowBox[{"potenciaSin", ",", "pasoBase"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"energiaReferenciaCon", "=", 
     RowBox[{"reglaTrapecio", "[", 
      RowBox[{"potenciaCon", ",", "pasoBase"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\< \>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<ENERGIA DE REFERENCIA\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Sin ventilador = \>\"", ",", "energiaReferenciaSin", 
      ",", "\"\< J\>\""}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Con ventilador = \>\"", ",", "energiaReferenciaCon", 
      ",", "\"\< J\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "METODO", " ", "MONTE", " ", "CARLO", " ", "PARA", " ", 
     "ENERGIA"}], "*)"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Interpolacion", " ", "de", " ", "la", " ", "potencia"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tiemposFinos", "=", 
     RowBox[{"resultadoSinVentilador", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"funcionPotenciaSin", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tiemposFinos", ",", "potenciaSin"}], "}"}], "]"}], ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"funcionPotenciaCon", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tiemposFinos", ",", "potenciaCon"}], "}"}], "]"}], ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Cantidades", " ", "de", " ", "muestras"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cantidadesN", "=", 
     RowBox[{"{", 
      RowBox[{
      "100", ",", "1000", ",", "10000", ",", "100000", ",", "1000000"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"repeticiones", "=", "10"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Funcion", " ", "Monte", " ", "Carlo"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"monteCarloEnergia", "[", 
      RowBox[{"funcion_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"tiempoTotal", "*", 
      RowBox[{"Mean", "[", 
       RowBox[{"funcion", "/@", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "tiempoTotal"}], "}"}], ",", "n"}], "]"}]}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Repetir", " ", "los", " ", "calculos"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "1234", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"resultadosMCSin", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"monteCarloEnergia", "[", 
          RowBox[{"funcionPotenciaSin", ",", "n"}], "]"}], ",", 
         RowBox[{"{", "repeticiones", "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "cantidadesN"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"resultadosMCCon", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"monteCarloEnergia", "[", 
          RowBox[{"funcionPotenciaCon", ",", "n"}], "]"}], ",", 
         RowBox[{"{", "repeticiones", "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "cantidadesN"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Calcular", " ", "error", " ", "RMSE"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"errorMCSin", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"Mean", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"resultadosMCSin", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", "energiaReferenciaSin"}], 
           ")"}], "^", "2"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "cantidadesN", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"errorMCCon", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"Mean", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"resultadosMCCon", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", "energiaReferenciaCon"}], 
           ")"}], "^", "2"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "cantidadesN", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\< \>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<ERRORES DE MONTE CARLO\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"TableForm", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"cantidadesN", ",", "errorMCSin", ",", "errorMCCon"}], "}"}],
         "]"}], ",", 
       RowBox[{"TableHeadings", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<N\>\"", ",", "\"\<Error sin ventilador (J)\>\"", 
            ",", "\"\<Error con ventilador (J)\>\""}], "}"}]}], "}"}]}]}], 
      "]"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Grafica", " ", "de", " ", "error"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"cantidadesN", ",", "errorMCSin"}], "}"}], "]"}], ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"cantidadesN", ",", "errorMCCon"}], "}"}], "]"}]}], "}"}], ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Sin ventilador\>\"", ",", "\"\<Con ventilador\>\""}], 
       "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Numero de muestras N\>\"", 
        ",", "\"\<Error RMSE (J)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Error del metodo Monte Carlo\>\""}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "PROBABILIDAD", " ", "DE", " ", "FALLA"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\< \>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<PROBABILIDAD DE FALLA\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Funcion", " ", "para", " ", "una", " ", "simulacion", " ", "con", " ", 
     "parametros", " ", "variables"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"simulacionFalla", "[", 
      RowBox[{"ra_", ",", "ch_", ",", "ta_", ",", "r25_", ",", "h_"}], "]"}], 
     ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"y", ",", "t", ",", "f", ",", "maximo", ",", "n"}], "}"}], ",", 
       RowBox[{
        RowBox[{"y", "=", 
         RowBox[{"{", 
          RowBox[{"ta", ",", "ta"}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"t", "=", "0."}], ";", "\[IndentingNewLine]", 
        RowBox[{"maximo", "=", "ta"}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Round", "[", 
          RowBox[{"tiempoTotal", "/", "h"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"f", "=", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"tt", ",", "estado"}], "}"}], ",", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "tj", ",", "th", ",", "potencia", ",", "dTj", ",", "dTh"}], 
              "}"}], ",", 
             RowBox[{
              RowBox[{"tj", "=", 
               RowBox[{"estado", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"th", "=", 
               RowBox[{"estado", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"potencia", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"corrienteDosNodos", "[", "tt", "]"}], "^", "2"}], "*", 
                RowBox[{"rdsOhm", "[", "tj", "]"}], "*", 
                RowBox[{"(", 
                 RowBox[{"r25", "/", "8."}], ")"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"dTj", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"potencia", "-", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"tj", "-", "th"}], ")"}], "/", "Rjh"}]}], ")"}], "/",
                 "Cj"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"dTh", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"tj", "-", "th"}], ")"}], "/", "Rjh"}], "-", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"th", "-", "ta"}], ")"}], "/", "ra"}]}], ")"}], "/",
                 "ch"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"dTj", ",", "dTh"}], "}"}]}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"y", "=", 
            RowBox[{"pasoRK4", "[", 
             RowBox[{"f", ",", "t", ",", "y", ",", "h"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"t", "=", 
            RowBox[{"i", "*", "h"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"maximo", "=", 
            RowBox[{"Max", "[", 
             RowBox[{"maximo", ",", 
              RowBox[{"y", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "maximo"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Numero", " ", "de", " ", "simulaciones"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numeroSimulaciones", "=", "1000"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pasoMonteCarlo", "=", "2.5"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Funcion", " ", "para", " ", "generar", " ", "parametros", " ", 
     "aleatorios", " ", "positivos"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"muestraPositiva", "[", "distribucion_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "valor", "}"}], ",", 
       RowBox[{
        RowBox[{"valor", "=", 
         RowBox[{"RandomVariate", "[", "distribucion", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"valor", "<=", "0"}], ",", 
          RowBox[{"valor", "=", 
           RowBox[{"RandomVariate", "[", "distribucion", "]"}]}]}], "]"}], ";",
         "\[IndentingNewLine]", "valor"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Simulaciones", " ", "sin", " ", "ventilador"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "2026", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maximosSin", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ra", ",", "ch", ",", "ta", ",", "r25"}], "}"}], ",", 
         RowBox[{
          RowBox[{"ra", "=", 
           RowBox[{"muestraPositiva", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"3.", ",", "0.3"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ch", "=", 
           RowBox[{"muestraPositiva", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"60.", ",", "6."}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ta", "=", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{"25.", ",", "45."}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"r25", "=", 
           RowBox[{"muestraPositiva", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"8.", ",", "0.8"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"simulacionFalla", "[", 
           RowBox[{
           "ra", ",", "ch", ",", "ta", ",", "r25", ",", "pasoMonteCarlo"}], 
           "]"}]}]}], "]"}], ",", 
       RowBox[{"{", "numeroSimulaciones", "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Simulaciones", " ", "con", " ", "ventilador"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maximosCon", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ra", ",", "ch", ",", "ta", ",", "r25"}], "}"}], ",", 
         RowBox[{
          RowBox[{"ra", "=", 
           RowBox[{"muestraPositiva", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"1.2", ",", "0.12"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ch", "=", 
           RowBox[{"muestraPositiva", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"60.", ",", "6."}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ta", "=", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"{", 
             RowBox[{"25.", ",", "45."}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"r25", "=", 
           RowBox[{"muestraPositiva", "[", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"8.", ",", "0.8"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"simulacionFalla", "[", 
           RowBox[{
           "ra", ",", "ch", ",", "ta", ",", "r25", ",", "pasoMonteCarlo"}], 
           "]"}]}]}], "]"}], ",", 
       RowBox[{"{", "numeroSimulaciones", "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Determinar", " ", "fallas"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fallasSin", "=", 
     RowBox[{"Count", "[", 
      RowBox[{"maximosSin", ",", 
       RowBox[{"x_", "/;", 
        RowBox[{"x", ">", "125."}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fallasCon", "=", 
     RowBox[{"Count", "[", 
      RowBox[{"maximosCon", ",", 
       RowBox[{"x_", "/;", 
        RowBox[{"x", ">", "125."}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"probabilidadSin", "=", 
     RowBox[{"N", "[", 
      RowBox[{"fallasSin", "/", "numeroSimulaciones"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"probabilidadCon", "=", 
     RowBox[{"N", "[", 
      RowBox[{"fallasCon", "/", "numeroSimulaciones"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Intervalos", " ", "de", " ", "confianza", " ", "del", " ", "95", " ", 
     "%"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"intervaloConfianza", "[", 
      RowBox[{"p_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "error", "}"}], ",", 
       RowBox[{
        RowBox[{"error", "=", 
         RowBox[{"1.96", "*", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"p", "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "p"}], ")"}], "/", "n"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"p", "-", "error"}]}], "]"}], ",", 
          RowBox[{"Min", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"p", "+", "error"}]}], "]"}]}], "}"}]}]}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"icSin", "=", 
     RowBox[{"intervaloConfianza", "[", 
      RowBox[{"probabilidadSin", ",", "numeroSimulaciones"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"icCon", "=", 
     RowBox[{"intervaloConfianza", "[", 
      RowBox[{"probabilidadCon", ",", "numeroSimulaciones"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
