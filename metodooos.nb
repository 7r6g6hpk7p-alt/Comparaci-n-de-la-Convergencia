   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Probabilidad = \>\"", ",", 
      RowBox[{"100", "*", "probabilidadSin"}], ",", "\"\< %\>\""}], "]"}], 
    ";"}], "\n", 
