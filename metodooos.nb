   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Probabilidad = \>\"", ",", 
      RowBox[{"100", "*", "probabilidadCon"}], ",", "\"\< %\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Intervalo de confianza = \>\"", ",", 
      RowBox[{"100", "*", 
       RowBox[{"icCon", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", "\"\< % a \>\"", ",", 
      RowBox[{"100", "*", 
       RowBox[{"icCon", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", "\"\< %\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "5.", " ", "HISTOGRAMAS", " ", "DE", " ", "TEMPERATURA", " ", "MAXIMA"}], 
