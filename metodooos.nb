Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ETAPA", " ", "3"}], ":", 
    RowBox[{"SIMULACION", " ", "TERMICA", " ", "DEL", " ", "MOSFET"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"MODELO", " ", "DE", " ", "UN", " ", "NODO"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<ETAPA 3 - MODELO DE UN NODO\>\"", "]"}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Parametros", "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"capacidad", "=", "62."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resistencia", "=", "3.8"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"corriente", "=", "30."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resistencia25", "=", "0.008"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alfa", "=", "0.0055"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ambiente", "=", "35."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"temperaturaInicial", "=", "35."}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tiempoFinal", "=", "600."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"paso", "=", "1."}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Ecuacion", " ", "diferencial"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fUnNodo", "[", 
      RowBox[{"t_", ",", "temp_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"corriente", "^", "2"}], "*", "resistencia25", "*", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"alfa", "*", 
            RowBox[{"(", 
             RowBox[{"temp", "-", "25"}], ")"}]}]}], ")"}]}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"temp", "-", "ambiente"}], ")"}], "/", "resistencia"}]}], 
       ")"}], "/", "capacidad"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solucion", " ", "exacta"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"q1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"corriente", "^", "2"}], "*", "resistencia25", "*", "alfa"}],
         "-", 
        RowBox[{"1", "/", "resistencia"}]}], ")"}], "/", "capacidad"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"q0", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"corriente", "^", "2"}], "*", "resistencia25", "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"alfa", "*", "25"}]}], ")"}]}], "+", 
        RowBox[{"ambiente", "/", "resistencia"}]}], ")"}], "/", 
      "capacidad"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"temperaturaEstacionaria", "=", 
     RowBox[{
      RowBox[{"-", "q0"}], "/", "q1"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"temperaturaExacta", "[", "t_", "]"}], ":=", 
     RowBox[{"temperaturaEstacionaria", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"temperaturaInicial", "-", "temperaturaEstacionaria"}], ")"}],
        "*", 
       RowBox[{"Exp", "[", 
