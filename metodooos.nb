    "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"DIFERENCIAS", " ", "FINITAS"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"derivadaAdelante", "=", 
     RowBox[{
      RowBox[{"Differences", "[", "temperaturasEnfriamiento", "]"}], "/", 
      RowBox[{"Differences", "[", "tiempos", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"derivadaCentral", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"temperaturasEnfriamiento", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
          RowBox[{"temperaturasEnfriamiento", "[", 
           RowBox[{"[", 
            RowBox[{"i", "-", "1"}], "]"}], "]"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"tiempos", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
          RowBox[{"tiempos", "[", 
           RowBox[{"[", 
            RowBox[{"i", "-", "1"}], "]"}], "]"}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", 
         RowBox[{
          RowBox[{"Length", "[", "tiempos", "]"}], "-", "1"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"derivadaAtras", "=", 
     RowBox[{
      RowBox[{"Differences", "[", "temperaturasEnfriamiento", "]"}], "/", 
      RowBox[{"Differences", "[", "tiempos", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"datosDerivadaCentral", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"tiempos", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", 
           RowBox[{"-", "2"}]}], "]"}], "]"}], ",", "derivadaCentral"}], 
       "}"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"datosDerivadaCentral", ",", 
     RowBox[{"PlotStyle", "->", "Red"}], ",", 
     RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Tiempo (s)\>\"", ",", "\"\<dT/dt (\[Degree]C/s)\>\""}], 
       "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Derivada central de la temperatura\>\""}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "AJUSTE", " ", "EXPONENCIAL", " ", "Y", " ", "CALCULO", " ", "DE", " ", 
     "Ch"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"temperaturaAmbiente", "=", "35"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resistenciaTermica", "=", "3"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ajusteEnfriamiento", "=", 
     RowBox[{"FindFit", "[", 
      RowBox[{"datosTemperatura", ",", 
       RowBox[{"temperaturaAmbiente", "+", 
        RowBox[{"amplitud", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "tiempoModelo"}], "/", "tauModelo"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"amplitud", ",", 
           RowBox[{
            RowBox[{"First", "[", "temperaturasEnfriamiento", "]"}], "-", 
            "temperaturaAmbiente"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"tauModelo", ",", "180"}], "}"}]}], "}"}], ",", 
       "tiempoModelo"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"amplitudCalculada", "=", 
     RowBox[{"amplitud", "/.", " ", "ajusteEnfriamiento"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tauCalculada", "=", 
     RowBox[{"tauModelo", "/.", " ", "ajusteEnfriamiento"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"capacitanciaTermica", "=", 
     RowBox[{"tauCalculada", "/", "resistenciaTermica"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\< \>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<RESULTADOS DE LA ETAPA 2\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Temperatura ambiente = \>\"", ",", "temperaturaAmbiente", 
      ",", "\"\< \[Degree]C\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Resistencia termica = \>\"", ",", "resistenciaTermica", 
      ",", "\"\< K/W\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Constante de tiempo tau = \>\"", ",", "tauCalculada", 
      ",", "\"\< s\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Capacitancia termica Ch = \>\"", ",", "capacitanciaTermica",
       ",", "\"\< J/K\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "COMPARACION", " ", "DEL", " ", "MODELO", " ", "CON", " ", "LOS", " ", 
     "DATOS"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{"datosTemperatura", ",", 
       RowBox[{"PlotStyle", "->", "Blue"}], ",", 
       RowBox[{"PlotMarkers", "->", "Automatic"}]}], "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"temperaturaAmbiente", "+", 
        RowBox[{"amplitudCalculada", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "tiempoModelo"}], "/", "tauCalculada"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"tiempoModelo", ",", 
         RowBox[{"Min", "[", "tiempos", "]"}], ",", 
         RowBox[{"Max", "[", "tiempos", "]"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Red"}]}], "]"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Tiempo (s)\>\"", 
        ",", "\"\<Temperatura (\[Degree]C)\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Comparacion del enfriamiento experimental y teorico\>\""}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\< \>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<FIN DE LAS ETAPAS 1 Y 2\>\"", "]"}], ";"}], 
   "\n"}]}]], "Input",
